{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "Voxera",
  "version": "0.1.1",
  "identifier": "com.voxera.app",
  "build": {
    "beforeDevCommand": "npm --prefix app run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix app run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voxera - 声音设计与角色音色工作台",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:28840 http://localhost:28840; media-src 'self' blob: http://127.0.0.1:28840 http://localhost:28840; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
